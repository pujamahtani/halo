{
  "name": "@pujamahtani/halo",
  "version": "0.2.0",
  "description": "A trust layer for AI interfaces. React components that help people understand, verify, and control AI as it works and acts inside a product, not just inside a chat.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Puja Mahtani (https://pujamahtani.com)",
  "homepage": "https://pujamahtani.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pujamahtani/halo.git"
  },
  "keywords": [
    "react",
    "ai",
    "ai-ux",
    "agent",
    "agentic",
    "trust",
    "human-in-the-loop",
    "design-system",
    "components",
    "confidence",
    "citations",
    "approval",
    "audit-log"
  ],
  "sideEffects": false,
  "main": "./dist/halo.cjs",
  "module": "./dist/halo.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/halo.js",
      "require": "./dist/halo.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "prepublishOnly": "npm run build:lib",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
